{
  "$schema": "vscode://schemas/color-theme",
  "name": "Red Rocks",
  "type": "dark",

  // All colors flow from the original 5-color palette (Ares Enyo):
  //   Ink    #16171f | Charcoal #3a3b3c | Sienna #a0522d
  //   Bronze #c77926 | Crimson  #990000
  //
  // Derived from southern Utah, kept low-chroma so nothing reads as candy:
  // Neutrals: bone #ddd2c0, shale #857c74, haze #a2adb4
  // Rock:     wingate-rust #cf6e52, coral-sand #d9967a,
  //           navajo-sandstone #d8bc92, slickrock #c2a89c
  // Plants:   sagebrush #a9ab86, juniper #86a195
  // Sky:      big-sky #93a8b6, dusk #b98e9e
  // Minimal:  muted-rust #c0604a, muted-sage #929a74,
  //           muted-dusk #a5899a

  "colors": {
    "editor.background":                "#16171f",
    "editor.foreground":                "#ddd2c0",
    "editor.lineHighlightBackground":   "#3a3b3c55",
    "editor.selectionBackground":       "#a0522d66",
    "editor.selectionHighlightBackground": "#3a3b3c33",
    "editor.wordHighlightBackground":   "#3a3b3c40",
    "editor.wordHighlightStrongBackground": "#3a3b3c55",
    "editor.findMatchBackground":       "#c7792655",
    "editor.findMatchHighlightBackground": "#c7792622",
    "editorCursor.foreground":          "#ddd2c0",
    "editorWhitespace.foreground":      "#3a3b3c40",
    "editorIndentGuide.background1":    "#3a3b3c30",
    "editorIndentGuide.activeBackground1": "#3a3b3c60",
    "editorLineNumber.foreground":      "#857c7480",
    "editorLineNumber.activeForeground": "#ddd2c0",
    "editorBracketMatch.background":    "#3a3b3c40",
    "editorBracketMatch.border":        "#c77926",
    "editorRuler.foreground":           "#3a3b3c40",
    "editorOverviewRuler.border":       "#16171f",
    "editorGutter.addedBackground":     "#929a74",
    "editorGutter.modifiedBackground":  "#a2adb4",
    "editorGutter.deletedBackground":   "#c0604a",
    "editorError.foreground":           "#c0604a",
    "editorWarning.foreground":         "#c77926",
    "editorInfo.foreground":            "#a2adb4",

    "sideBar.background":               "#16171f",
    "sideBar.foreground":               "#ddd2c0",
    "sideBar.border":                   "#ffffff22",
    "sideBarTitle.foreground":          "#ddd2c0",
    "sideBarSectionHeader.background":  "#16171f",
    "sideBarSectionHeader.foreground":  "#ddd2c0cc",

    "activityBar.background":           "#16171f",
    "activityBar.foreground":           "#ddd2c0",
    "activityBar.inactiveForeground":   "#857c7488",
    "activityBar.border":               "#ffffff22",
    "activityBarBadge.background":      "#c77926",
    "activityBarBadge.foreground":      "#16171f",

    "titleBar.activeBackground":        "#16171f",
    "titleBar.activeForeground":        "#ddd2c0",
    "titleBar.inactiveBackground":      "#16171f",
    "titleBar.inactiveForeground":      "#857c7488",
    "titleBar.border":                  "#ffffff22",

    "editorGroupHeader.tabsBackground": "#16171f",
    "tab.activeBackground":             "#16171f",
    "tab.activeForeground":             "#ddd2c0",
    "tab.activeBorderTop":              "#c77926",
    "tab.inactiveBackground":           "#16171f",
    "tab.inactiveForeground":           "#857c7499",
    "tab.border":                       "#ffffff22",
    "tab.hoverBackground":              "#16171f80",

    "statusBar.background":             "#16171f",
    "statusBar.foreground":             "#ddd2c0cc",
    "statusBar.border":                 "#ffffff22",
    "statusBar.debuggingBackground":    "#990000",
    "statusBar.debuggingForeground":    "#ddd2c0",
    "statusBar.noFolderBackground":     "#16171f",
    "statusBarItem.remoteBackground":   "#c77926",
    "statusBarItem.remoteForeground":   "#16171f",
    "statusBarItem.hoverBackground":    "#3a3b3c66",

    "terminal.background":              "#16171f",
    "terminal.foreground":              "#ddd2c0",
    "terminal.ansiBlack":               "#16171f",
    "terminal.ansiRed":                 "#c0604a",
    "terminal.ansiGreen":               "#9aa47e",
    "terminal.ansiYellow":              "#d0a868",
    "terminal.ansiBlue":                "#93a8b6",
    "terminal.ansiMagenta":             "#b98e9e",
    "terminal.ansiCyan":                "#86a195",
    "terminal.ansiWhite":               "#ddd2c0",
    "terminal.ansiBrightBlack":         "#857c74",
    "terminal.ansiBrightRed":           "#d9806a",
    "terminal.ansiBrightGreen":         "#b4b996",
    "terminal.ansiBrightYellow":        "#d8bc92",
    "terminal.ansiBrightBlue":          "#a9bccb",
    "terminal.ansiBrightMagenta":       "#c9aab4",
    "terminal.ansiBrightCyan":          "#a2bcb0",
    "terminal.ansiBrightWhite":         "#f0e8da",

    "panel.background":                 "#16171f",
    "panel.border":                     "#ffffff22",
    "panelTitle.activeBorder":          "#c77926",
    "panelTitle.activeForeground":      "#ddd2c0",
    "panelTitle.inactiveForeground":    "#857c7488",

    "input.background":                 "#16171f",
    "input.foreground":                 "#ddd2c0",
    "input.border":                     "#3a3b3c",
    "input.placeholderForeground":      "#857c7477",
    "inputOption.activeBorder":         "#c77926",
    "inputOption.activeBackground":     "#c7792633",
    "inputValidation.errorBackground":  "#16171f",
    "inputValidation.errorBorder":      "#c0604a",
    "inputValidation.warningBackground":"#16171f",
    "inputValidation.warningBorder":    "#c77926",

    "dropdown.background":              "#16171f",
    "dropdown.foreground":              "#ddd2c0",
    "dropdown.border":                  "#3a3b3c",

    "list.activeSelectionBackground":   "#3a3b3c55",
    "list.activeSelectionForeground":   "#ddd2c0",
    "list.inactiveSelectionBackground": "#3a3b3c30",
    "list.hoverBackground":            "#3a3b3c22",
    "list.highlightForeground":         "#d8bc92",
    "list.focusOutline":                "#c7792666",

    "quickInput.background":            "#16171f",
    "quickInput.foreground":            "#ddd2c0",
    "quickInputList.focusBackground":   "#3a3b3c55",

    "minimap.selectionHighlight":       "#c7792666",
    "minimapSlider.background":         "#3a3b3c22",
    "minimapSlider.hoverBackground":    "#3a3b3c44",
    "minimapSlider.activeBackground":   "#3a3b3c55",

    "scrollbar.shadow":                 "#00000033",
    "scrollbarSlider.background":       "#3a3b3c44",
    "scrollbarSlider.hoverBackground":  "#3a3b3c66",
    "scrollbarSlider.activeBackground": "#3a3b3c88",

    "peekView.border":                  "#c77926",
    "peekViewEditor.background":        "#16171f",
    "peekViewResult.background":        "#16171f",
    "peekViewResult.selectionBackground": "#3a3b3c55",
    "peekViewTitle.background":         "#16171f",
    "peekViewTitleDescription.foreground": "#857c74",

    "diffEditor.insertedTextBackground": "#929a7422",
    "diffEditor.removedTextBackground":  "#c0604a22",

    "gitDecoration.modifiedResourceForeground": "#a2adb4",
    "gitDecoration.deletedResourceForeground":  "#c0604a",
    "gitDecoration.untrackedResourceForeground":"#929a74",
    "gitDecoration.conflictingResourceForeground":"#a5899a",
    "gitDecoration.ignoredResourceForeground":  "#857c7466",

    "editorBracketHighlight.foreground1": "#cf6e52",
    "editorBracketHighlight.foreground2": "#93a8b6",
    "editorBracketHighlight.foreground3": "#b98e9e",
    "editorBracketHighlight.foreground4": "#86a195",
    "editorBracketHighlight.foreground5": "#c77926",
    "editorBracketHighlight.foreground6": "#d8bc92",

    "breadcrumb.foreground":            "#857c7499",
    "breadcrumb.focusForeground":       "#ddd2c0",
    "breadcrumb.activeSelectionForeground": "#ddd2c0",

    "badge.background":                 "#c77926",
    "badge.foreground":                 "#16171f",

    "button.background":                "#990000",
    "button.foreground":                "#ddd2c0",
    "button.hoverBackground":          "#a0522d",

    "focusBorder":                      "#c7792666",

    "widget.shadow":                    "#00000044",
    "editorWidget.background":          "#16171f",
    "editorWidget.border":              "#ffffff22",

    "notificationCenter.border":        "#ffffff22",
    "notifications.background":         "#16171f",
    "notifications.foreground":         "#ddd2c0",
    "notifications.border":             "#ffffff22"
  },

  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#857c74", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#a9ab86" }
    },
    {
      "name": "Docstrings",
      "scope": ["string.quoted.docstring", "string.quoted.multi"],
      "settings": { "foreground": "#a9ab86", "fontStyle": "italic" }
    },
    {
      "name": "Escape sequences",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#c77926" }
    },
    {
      "name": "F-string braces",
      "scope": [
        "constant.character.format.placeholder.other.python",
        "punctuation.definition.interpolation.begin",
        "punctuation.definition.interpolation.end"
      ],
      "settings": { "foreground": "#c77926" }
    },
    {
      "name": "Magic variables (__name__, __file__)",
      "scope": ["support.variable.magic.python"],
      "settings": { "foreground": "#86a195", "fontStyle": "italic" }
    },
    {
      "name": "ALL_CAPS constants",
      "scope": ["constant.other.caps", "constant.other.caps.python"],
      "settings": { "foreground": "#d9967a" }
    },
    {
      "name": "global / nonlocal",
      "scope": ["storage.modifier.declaration.python"],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#ddd2c0" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "keyword.operator.logical", "keyword.operator.logical.python"],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "Control flow",
      "scope": ["keyword.control.flow", "keyword.control.flow.python"],
      "settings": { "foreground": "#cf6e52", "fontStyle": "bold" }
    },
    {
      "name": "Import keywords",
      "scope": ["keyword.control.import", "keyword.control.import.python"],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator", "keyword.operator.assignment",
        "keyword.operator.arithmetic", "keyword.operator.comparison",
        "keyword.operator.bitwise"
      ],
      "settings": { "foreground": "#ddd2c0bb" }
    },
    {
      "name": "Storage type (def, class, lambda, async, await)",
      "scope": ["storage.type", "storage.type.function", "storage.type.class", "keyword.control.flow.python"],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "Function definitions",
      "scope": ["entity.name.function", "entity.name.function.python", "meta.function.python"],
      "settings": { "foreground": "#93a8b6" }
    },
    {
      "name": "Function calls",
      "scope": ["meta.function-call.generic", "meta.function-call.python"],
      "settings": { "foreground": "#93a8b6" }
    },
    {
      "name": "Builtin functions",
      "scope": ["support.function", "support.function.builtin.python"],
      "settings": { "foreground": "#86a195" }
    },
    {
      "name": "Magic/dunder methods",
      "scope": ["support.function.magic.python"],
      "settings": { "foreground": "#86a195", "fontStyle": "italic" }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator", "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python", "meta.function.decorator.python"
      ],
      "settings": { "foreground": "#c77926", "fontStyle": "italic" }
    },
    {
      "name": "Class definitions",
      "scope": ["entity.name.type.class", "entity.name.type.class.python"],
      "settings": { "foreground": "#d8bc92", "fontStyle": "bold" }
    },
    {
      "name": "Inherited class names",
      "scope": ["entity.other.inherited-class", "entity.other.inherited-class.python"],
      "settings": { "foreground": "#d8bc92" }
    },
    {
      "name": "Type hints / annotations",
      "scope": ["support.type", "support.type.python", "meta.function.parameters.python support.type"],
      "settings": { "foreground": "#86a195" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "#ddd2c0" }
    },
    {
      "name": "Self / cls",
      "scope": [
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.language.special.self.python"
      ],
      "settings": { "foreground": "#c2a89c", "fontStyle": "italic" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "variable.parameter.function.python"],
      "settings": { "foreground": "#ddd2c0dd" }
    },
    {
      "name": "Constants (True, False, None)",
      "scope": ["constant.language", "constant.language.python"],
      "settings": { "foreground": "#d9967a", "fontStyle": "bold" }
    },
    {
      "name": "Numeric literals",
      "scope": [
        "constant.numeric", "constant.numeric.integer", "constant.numeric.float",
        "constant.numeric.hex", "constant.numeric.oct", "constant.numeric.bin"
      ],
      "settings": { "foreground": "#b98e9e" }
    },
    {
      "name": "Builtin types",
      "scope": ["support.type.python"],
      "settings": { "foreground": "#86a195" }
    },
    {
      "name": "Exception types",
      "scope": ["support.type.exception.python"],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "Brackets / parens / braces",
      "scope": [
        "punctuation.definition.list.begin", "punctuation.definition.list.end",
        "punctuation.definition.dict.begin", "punctuation.definition.dict.end",
        "punctuation.parenthesis.begin", "punctuation.parenthesis.end",
        "punctuation.separator", "punctuation.separator.colon",
        "punctuation.separator.element", "meta.brace"
      ],
      "settings": { "foreground": "#ddd2c0aa" }
    },
    {
      "name": "Imported module names",
      "scope": ["source.python meta.statement.import.python", "entity.name.import.python"],
      "settings": { "foreground": "#ddd2c0" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#d8bc92", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup inline code",
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#ddd2c0" }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#93a8b6" }
    },

    // ── HTML ─────────────────────────────────────────────────
    {
      "name": "HTML tag angle brackets",
      "scope": [
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end",
        "punctuation.definition.tag"
      ],
      "settings": { "foreground": "#857c7499" }
    },
    {
      "name": "HTML tag names",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "meta.tag.html"
      ],
      "settings": { "foreground": "#93a8b6" }
    },
    {
      "name": "HTML attribute names",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html"
      ],
      "settings": { "foreground": "#c77926" }
    },
    {
      "name": "HTML attribute values",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": { "foreground": "#d8bc92" }
    },
    {
      "name": "HTML doctype",
      "scope": [
        "meta.tag.sgml.doctype.html",
        "entity.name.tag.doctype"
      ],
      "settings": { "foreground": "#857c7499", "fontStyle": "italic" }
    },
    {
      "name": "HTML entities",
      "scope": [
        "constant.character.entity.html",
        "punctuation.definition.entity.html"
      ],
      "settings": { "foreground": "#b98e9e" }
    },

    // ── CSS ──────────────────────────────────────────────────
    {
      "name": "CSS element selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.name.tag.scss",
        "entity.name.tag.less"
      ],
      "settings": { "foreground": "#93a8b6" }
    },
    {
      "name": "CSS class selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.scss",
        "entity.other.attribute-name.class.less"
      ],
      "settings": { "foreground": "#d8bc92" }
    },
    {
      "name": "CSS ID selectors",
      "scope": [
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.id.scss",
        "entity.other.attribute-name.id.less"
      ],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "CSS pseudo-classes and pseudo-elements",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "entity.other.attribute-name.pseudo-class.scss",
        "entity.other.attribute-name.pseudo-element.scss"
      ],
      "settings": { "foreground": "#c2a89c", "fontStyle": "italic" }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "meta.property-name.css"
      ],
      "settings": { "foreground": "#86a195" }
    },
    {
      "name": "CSS property values (keywords)",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.property-value.scss",
        "meta.property-value.css"
      ],
      "settings": { "foreground": "#ddd2c0" }
    },
    {
      "name": "CSS units",
      "scope": [
        "keyword.other.unit.css",
        "keyword.other.unit.scss",
        "keyword.other.unit.less"
      ],
      "settings": { "foreground": "#b98e9e" }
    },
    {
      "name": "CSS at-rules",
      "scope": [
        "keyword.control.at-rule.css",
        "keyword.control.at-rule.scss",
        "keyword.control.at-rule.less",
        "punctuation.definition.keyword.css"
      ],
      "settings": { "foreground": "#cf6e52" }
    },
    {
      "name": "CSS !important",
      "scope": ["keyword.other.important.css"],
      "settings": { "foreground": "#cf6e52", "fontStyle": "bold" }
    },
    {
      "name": "CSS hex colors",
      "scope": [
        "constant.other.color.rgb-value.css",
        "constant.other.color.rgb-value.scss",
        "constant.other.color"
      ],
      "settings": { "foreground": "#b98e9e" }
    },
    {
      "name": "CSS named colors",
      "scope": ["support.constant.color.w3c-standard-color-name.css"],
      "settings": { "foreground": "#b98e9e" }
    },
    {
      "name": "CSS custom properties (variables)",
      "scope": [
        "variable.other.custom-property.name.css",
        "variable.css"
      ],
      "settings": { "foreground": "#a2adb4" }
    },
    {
      "name": "CSS punctuation (braces, colons, semicolons)",
      "scope": [
        "punctuation.section.property-list.begin.bracket.curly.css",
        "punctuation.section.property-list.end.bracket.curly.css",
        "punctuation.terminator.rule.css",
        "punctuation.separator.key-value.css"
      ],
      "settings": { "foreground": "#ddd2c0aa" }
    },
    {
      "name": "CSS selector combinators",
      "scope": ["keyword.operator.combinator.css"],
      "settings": { "foreground": "#857c7499" }
    },
    {
      "name": "SCSS variables",
      "scope": ["variable.scss", "variable.sass"],
      "settings": { "foreground": "#a2adb4" }
    },
    {
      "name": "SCSS/LESS mixins and functions",
      "scope": [
        "entity.name.function.scss",
        "support.function.misc.css"
      ],
      "settings": { "foreground": "#93a8b6" }
    }
  ],

  "semanticHighlighting": true,
  "semanticTokenColors": {
    // ── Keywords & control ────────────────────────────────────
    "keyword": "#cf6e52",
    "keyword.declaration": { "foreground": "#cf6e52", "fontStyle": "bold" },
    "keyword.controlFlow": { "foreground": "#cf6e52", "fontStyle": "bold" },

    // ── Operators ─────────────────────────────────────────────
    "operator": "#ddd2c0bb",

    // ── Comments ──────────────────────────────────────────────
    "comment": { "foreground": "#857c74", "fontStyle": "italic" },

    // ── Strings & regex ───────────────────────────────────────
    "string": "#a9ab86",
    "regexp": "#ddd2c0",

    // ── Numbers ───────────────────────────────────────────────
    "number": "#b98e9e",

    // ── Variables ─────────────────────────────────────────────
    "variable": "#ddd2c0",
    "variable.declaration": "#ddd2c0",
    "variable.readonly": "#d9967a",
    "variable.defaultLibrary": "#86a195",
    "variable.typeHint": "#86a195",

    // ── Parameters ────────────────────────────────────────────
    "parameter": "#ddd2c0dd",
    "parameter.declaration": "#ddd2c0dd",
    "selfParameter": { "foreground": "#c2a89c", "fontStyle": "italic" },
    "clsParameter": { "foreground": "#c2a89c", "fontStyle": "italic" },

    // ── Properties ────────────────────────────────────────────
    "property": "#ddd2c0cc",
    "property.declaration": "#ddd2c0cc",
    "property.readonly": "#d9967a",

    // ── Functions ─────────────────────────────────────────────
    "function": "#93a8b6",
    "function.declaration": "#93a8b6",
    "function.defaultLibrary": "#86a195",
    "method": "#93a8b6",
    "method.declaration": "#93a8b6",
    "method.defaultLibrary": "#86a195",
    "magicFunction": { "foreground": "#86a195", "fontStyle": "italic" },
    "magicFunction.declaration": { "foreground": "#86a195", "fontStyle": "italic" },

    // ── Decorators ────────────────────────────────────────────
    "decorator": { "foreground": "#c77926", "fontStyle": "italic" },

    // ── Classes & types ───────────────────────────────────────
    "class": "#d8bc92",
    "class.declaration": { "foreground": "#d8bc92", "fontStyle": "bold" },
    "class.defaultLibrary": "#86a195",
    "type": "#86a195",
    "type.declaration": "#86a195",
    "type.defaultLibrary": "#86a195",
    "typeParameter": "#86a195",
    "enum": "#86a195",
    "enumMember": "#b98e9e",
    "interface": "#86a195",
    "struct": "#d8bc92",

    // ── Modules & namespaces ──────────────────────────────────
    "namespace": "#ddd2c0",
    "module": "#ddd2c0",
    "module.declaration": "#ddd2c0",

    // ── Constants ─────────────────────────────────────────────
    "builtinConstant": { "foreground": "#d9967a", "fontStyle": "bold" },

    // ── Catch-all for any remaining Pylance tokens ────────────
    "*.declaration": {},
    "*.defaultLibrary": {},
    "*.typeHint": {}
  }
}
